NODE_ENV=production
HOST=0.0.0.0
# Railway supplies PORT; leave it unset on Railway.
PORT=3663
# Exact frontend origins, without repository paths or trailing slashes.
CORS_ORIGINS=https://YOUR-ACCOUNT.github.io
TRUST_PROXY=1
DB_CLIENT=mysql2
DB_HOST=YOUR-PRIVATE-MYSQL-HOST
DB_PORT=3306
DB_NAME=mini_hrms
DB_USER=YOUR-MYSQL-USER
DB_PASSWORD=SET-IN-RAILWAY
SECURITY_KEY=SET-A-LONG-RANDOM-SECRET-IN-RAILWAY
PORTAL_SECURITY_KEY=SET-A-DIFFERENT-LONG-RANDOM-SECRET-IN-RAILWAY
# Optional password recovery mail provider.
MAIL_NAME=
MAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
